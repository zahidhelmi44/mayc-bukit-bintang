  <script>
    // Instagram has no web share URL: use the phone's share sheet (Instagram Story/DM appear there),
    // or copy the link on desktop where the share sheet is not available.
    const box = document.querySelector<HTMLElement>('[data-share]');
    if (box) {
      const { title = '', url = location.href } = box.dataset;
      const note = box.querySelector<HTMLElement>('[data-share-note]')!;
      const say = (text: string) => { note.textContent = text; };
      const copy = async (text: string) => {
        try { await navigator.clipboard.writeText(url); say(text); } catch { say(`Copy this link: ${url}`); }
      };
      box.querySelector('[data-share-native]')?.addEventListener('click', async () => {
        if (navigator.share) {
          try { await navigator.share({ title, url }); } catch { /* dismissed */ }
          return;
        }
        copy('Link copied — paste it into your Instagram story or DM.');
      });
      box.querySelector('[data-share-copy]')?.addEventListener('click', () => copy('Link copied.'));
    }
  </script>

