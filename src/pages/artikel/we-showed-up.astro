---
import ArticleComments from '../../components/ArticleComments.astro';
import Base from '../../layouts/Base.astro';

const results = [
  {
    label: 'FIXED OPEN · CATEGORY A',
    rows: [
      ['01', 'Mohamad Aidil Bin Mohamad Ayub', 'Bib #23 · 04:35.00'],
      ['02', 'Al Kenedy', 'Bib #2 · 04:38.00'],
      ['03', 'Nik Akif Iman Bin Mohd Riza', 'Bib #31'],
    ],
  },
  {
    label: 'MEN MIXED OPEN · CATEGORY B',
    rows: [
      ['01', 'Ahmad Luqmaan Bin Azman Shah', 'Bib #9 · 03:46.00'],
      ['02', 'Mohamad Aidil Bin Mohamad Ayub', 'Bib #21 · 03:47.00'],
      ['03', 'Muhammad Haziq Danish Bin Norizam', 'Bib #33'],
    ],
  },
  {
    label: 'WOMEN MIXED OPEN · CATEGORY C',
    rows: [
      ['01', 'Nurzarina Binti Mohammad Zaki', 'Bib #29 · 05:24.00'],
      ['02', 'Husna Razali', 'Bib #25 · 05:36.00'],
      ['03', 'Noraidillina Adilla J. Sam', 'Bib #48'],
    ],
  },
  {
    label: 'LAST MAN STANDING',
    rows: [
      ['01', 'Mohamad Aidil Bin Mohamad Ayub', 'Bib #23'],
      ['02', 'Muhammad Haziq Danish Bin Norizam', 'Bib #33'],
      ['03', 'Nik Akif Iman Bin Mohd Riza', 'Bib #31'],
    ],
  },
];

const pedigree = [
  {
    name: 'NASRUL FIRAS BIN RIDZUAN',
    line: 'Selangor cycling athlete listed for SUKMA Sarawak 2024 and SUKMA Selangor 2026.',
    source: 'https://msnselangor.gov.my/sukma-xxii-selangor-2026/direktori-kontinjen-selangor-sukma-selangor-2026-2/kontinjen-berbasikal-2026/',
  },
  {
    name: 'MUHAMMAD HAZIQ DANISH BIN NORIZAM',
    line: 'SUKMA Selangor rider with road-racing and U23 mountain-bike results on record.',
    source: 'https://www.procyclingstats.com/rider/muhammad-haziq-danish-bin-norizam',
  },
  {
    name: 'MOHAMAD AIDIL BIN MOHAMAD AYUB',
    line: 'A Malaysian junior road and track competitor who arrived with national-championship race miles.',
    source: 'https://www.procyclingstats.com/rider/mohamad-aidil-bin-mohamad-ayub',
  },
  {
    name: 'NORAIDILLINA ADILLA J. SAM',
    line: 'An experienced Malaysian cyclist with Asian track, Singapore Cycling Cup and para-cycling competition history.',
    source: 'https://www.ukm.my/news/Latest_News/atlet-ping-pong-dan-berbasikal-dinobat-olahragawan-dan-olahragawati-ukm/',
  },
  {
    name: 'AL KENEDY',
    line: 'A familiar name in Malaysia’s fixed-gear scene, Kenedy brought years of competitive urban cycling experience into the Metro Madness field — eventually finishing second in the Fixed Gear final.',
  },
  {
    name: 'MOHD RAZIF MOHD SALLEH',
    line: 'A former UCI Continental rider with LeTua Cycling Team, Razif brought years of Malaysian road and off-road racing experience into the Men Mixed field.',
  },
  {
    name: 'MOHD SHAFARI “AWIE” ABDUL MALIK',
    line: 'A veteran of Malaysian road and mountain-bike racing, Awie brought more than two decades of competitive cycling experience to the Metro Madness field.',
  },
  {
    // Present at Pedal & Connect Vol.2; organiser records do not show her racing Metro Madness.
    name: 'RINA ZAKI',
    line: 'Malaysian MTB racer and 2024 Selangor King of Mountain Women’s Open champion, Rina Zaki was among the established cycling names present at Pedal & Connect Vol.2.',
  },
];

const img = (name: string) => `/media/metro-after-dark/${name}`;

const shareTitle = 'WE SHOWED UP — Pedal & Connect Vol.2 × Metro Madness! Vol.2';
const shareUrl = new URL('/artikel/we-showed-up/', Astro.site).toString();
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(`${shareTitle}\n${shareUrl}`)}`;

// Each photo ships as name-800.webp (half width), name.webp (default) and, for full-bleed shots, name-2400.webp.
// Attributes are written out on each <img> rather than spread, so Astro keeps the scoped-style attribute on them.
const srcset = (name: string, { width = 1600, xl = false } = {}) =>
  [
    `${img(`${name}-800.webp`)} ${Math.floor(width / 2)}w`,
    `${img(`${name}.webp`)} ${width}w`,
    ...(xl ? [`${img(`${name}-2400.webp`)} 2400w`] : []),
  ].join(', ');

const sponsors = [
  { file: 'kbs.png', name: 'Kementerian Belia dan Sukan', kind: 'badge', width: 240, height: 240 },
  { file: 'rakan-muda.png', name: 'Rakan Muda', kind: 'badge', width: 240, height: 240 },
  { file: 'ridewild.png', name: 'RideWild', kind: 'mark', width: 431, height: 140 },
  { file: 'mayhem.png', name: 'Mayhem', kind: 'mark', width: 606, height: 140 },
  { file: 'velo-vibe.png', name: 'Velo Vibe', kind: 'stack', width: 263, height: 240 },
  { file: 'worthless.png', name: 'Worthless', kind: 'mark', width: 656, height: 140 },
  { file: 'ops.png', name: 'ops!', kind: 'stack', width: 277, height: 240 },
  { file: 'versussika.png', name: 'Versussika', kind: 'mark', width: 448, height: 140 },
  { file: 'tits.png', name: 'TITS', kind: 'badge', width: 181, height: 240 },
  { file: 'pcc.png', name: 'Panda Cyclist Clan', kind: 'badge', width: 240, height: 240 },
  { file: 'motion-lab.png', name: 'Motion Lab', kind: 'stack', width: 958, height: 140 },
  { file: 'ybc.png', name: 'YBC', kind: 'stack', width: 600, height: 254 },
];
---

<Base
  lang="en"
  title="WE SHOWED UP — Pedal & Connect Vol.2 × Metro Madness! Vol.2"
  description="A night of bikes, people, rain and pure madness — Pedal & Connect Vol.2 × Metro Madness! Vol.2 at IYC Cheras."
  image={img('og.jpg')}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  halaman="artikel"
  barBawah={false}
>
  <article class="mad">
    <section class="mad-hero">
      <img src={img('hero.webp')} srcset={srcset('hero', { xl: true })} sizes="100vw" width="1600" height="1066" alt="Riders launching from the start line at Metro Madness Vol.2" fetchpriority="high" decoding="async" />
      <div class="mad-hero-shade"></div>
      <div class="mad-hero-copy">
        <p class="mad-kicker">26.09.2026 / IYC CHERAS / KUALA LUMPUR</p>
        <h1><span>WE</span><span>SHOWED</span><span>UP.</span></h1>
        <p class="mad-sub">PEDAL &amp; CONNECT VOL.2 × METRO MADNESS! VOL.2</p>
        <p class="mad-scroll">A NIGHT OF BIKES, PEOPLE, RAIN &amp; PURE MADNESS. <span>SCROLL ↓</span></p>
      </div>
    </section>

    <section class="mad-light mad-intro mad-pad">
      <div class="mad-narrow">
        <p class="mad-kicker dark">WHY THIS NIGHT EXISTED</p>
        <div class="mad-lead">
          <p>Some came to race. Some came for their friends. Some came with a crew. Some volunteered. Some simply wanted to see what was happening.</p>
          <p>Different ages. Different backgrounds. Different reasons for showing up.</p>
          <p><strong>Same place. Same night. Same energy.</strong></p>
          <p>For MAYC Bukit Bintang, that was the point. Pedal &amp; Connect was never built around cycling alone. It was built around bringing young people into the same space — to meet, participate, contribute and find a community.</p>
          <p>This time, bikes were the connection.</p>
        </div>
      </div>
      <div class="mad-statement dark">GIVE YOUNG PEOPLE<br/>A REASON TO<br/>COME TOGETHER.</div>
      <figure class="mad-photo medium">
        <img src={img('smile.webp')} srcset={srcset('smile')} sizes="min(1080px, 90vw)" width="1600" height="1066" alt="A rider smiling after a Metro Madness race" loading="lazy" decoding="async" />
      </figure>
    </section>

    <section class="mad-dark mad-sound mad-pad">
      <div class="mad-narrow">
        <p class="mad-kicker">PUT THIS ON FIRST.</p>
        <h2>THIS STORY<br/>HAS A SOUNDTRACK.</h2>
        <p class="mad-muted">Hit play. Keep scrolling.</p>
        <div class="spotify-stack">
          <iframe title="Victory Lap by Fred again.., Skepta and PlaqueBoyMax on Spotify" src="https://open.spotify.com/embed/track/1lbNgoJ5iMrMluCyhI4OQP?utm_source=generator" width="100%" height="152" frameborder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
          <iframe title="WE ON GO II by BIA, A$AP Ferg and Denzel Curry on Spotify" src="https://open.spotify.com/embed/track/4M0jSlN1MOaVRbA3Shr0FV?utm_source=generator" width="100%" height="152" frameborder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
        <p class="mad-kicker sound-end">PRESS PLAY → KEEP MOVING</p>
      </div>
    </section>

    <section class="mad-light mad-opening mad-pad">
      <div class="mad-split">
        <figure class="mad-photo"><img src={img('dato-arman.webp')} srcset={srcset('dato-arman')} sizes="(min-width: 760px) 45vw, 100vw" width="1600" height="1066" alt="Dato' Arman at the opening of Pedal & Connect Vol.2" loading="lazy" decoding="async" /></figure>
        <div class="mad-copyblock">
          <p class="mad-kicker dark">00:00 / BEFORE THE FLAG DROPPED</p>
          <h2>READY<br/>TO RACE?</h2>
          <p>The night was officially opened by <strong>Dato’ Arman, President of KLCA</strong>. His message was short: the value of the night was bigger than a race — it was about people meeting beyond background, race or religion through a shared interest in cycling.</p>
          <blockquote>“I know you guys are ready to race tonight.”</blockquote>
          <p class="mad-by">DATO’ ARMAN<br/><span>PRESIDENT / KLCA</span></p>
        </div>
      </div>
      <div class="mad-go"><span>RACE STATUS</span><strong>GO →</strong></div>
    </section>

    <section class="mad-dark mad-grid mad-pad">
      <div class="mad-wide">
        <p class="mad-kicker">THE GRID</p>
        <h2>EVERYBODY<br/>WANTED IN.</h2>
        <div class="mad-facts"><span>TRACK / 555M</span><span>CONDITIONS / WET</span><span>NIGHT RACE / IYC</span><span>MALAYSIA + SINGAPORE</span></div>
      </div>
      <figure class="mad-photo full"><img src={img('grid.webp')} srcset={srcset('grid', { xl: true })} sizes="min(1450px, 96vw)" width="1600" height="1066" alt="Riders gathered on the start grid before a Metro Madness heat" loading="lazy" decoding="async" /></figure>
    </section>

    <section class="mad-dark mad-track mad-pad">
      <div class="mad-wide">
        <p class="mad-number">555M</p>
        <h2>SHORT ENOUGH TO LOOK EASY.<br/><span>TECHNICAL ENOUGH TO PROVE OTHERWISE.</span></h2>
        <p class="mad-two-line">The rain had stopped.<br/>The track hadn’t forgotten.</p>
      </div>
      <div class="mad-race-grid">
        <figure class="mad-photo"><img src={img('race-01.webp')} srcset={srcset('race-01')} sizes="(min-width: 760px) 48vw, 100vw" width="1600" height="1066" alt="A rider attacking a wet technical corner at Metro Madness Vol.2" loading="lazy" decoding="async" /></figure>
        <figure class="mad-photo"><img src={img('race-02.webp')} srcset={srcset('race-02')} sizes="(min-width: 760px) 48vw, 100vw" width="1600" height="1070" alt="A rider racing through a technical corner at night" loading="lazy" decoding="async" /></figure>
        <figure class="mad-photo wide-img"><img src={img('race-03.webp')} srcset={srcset('race-03', { xl: true })} sizes="min(1450px, 96vw)" width="1600" height="1066" alt="A rider on a green bike leaning hard into a corner" loading="lazy" decoding="async" /></figure>
      </div>
      <div class="mad-statement">WET TARMAC.<br/>TIGHT CORNERS.<br/>NO FREE LAPS.</div>
    </section>

    <section class="mad-light mad-pedigree mad-pad">
      <div class="mad-wide">
        <p class="mad-kicker dark">RACE MILES</p>
        <h2>NOT EVERYONE<br/>ON THAT GRID<br/>WAS NEW TO THIS.</h2>
        <p class="mad-muted-dark">The field mixed emerging riders and community racers with state, national and international competition experience — and the night drew established names from across Malaysian cycling.</p>
        <div class="pedigree-grid">
          {pedigree.map((r, i) => (
            <article class="pedigree-card">
              <span class="pedigree-no">0{i + 1}</span>
              <h3>{r.name}</h3>
              <p>{r.line}</p>
              {r.source && <a href={r.source} target="_blank" rel="noopener">SOURCE ↗</a>}
            </article>
          ))}
        </div>
      </div>
      <div class="mad-photo-pair">
        <figure><img src={img('al-kenedy.webp')} srcset={srcset('al-kenedy', { width: 1421 })} sizes="(min-width: 760px) 36vw, 50vw" width="1421" height="2133" alt="Al Kenedy at Metro Madness Vol.2" loading="lazy" decoding="async" /></figure>
        <figure><img src={img('dini-akhbar.webp')} srcset={srcset('dini-akhbar')} sizes="(min-width: 760px) 57vw, 50vw" width="1600" height="1066" alt="Dini Akhbar racing at Metro Madness Vol.2" loading="lazy" decoding="async" /></figure>
      </div>
    </section>

    <section class="mad-dark mad-loud mad-pad">
      <div class="mad-wide">
        <p class="mad-kicker">THEN IT GOT LOUD</p>
        <div class="mad-beats">
          <span>ONE CORNER.</span>
          <span>ONE MOVE.</span>
          <span>ONE MISTAKE.</span>
          <span>KEEP PEDALLING.</span>
        </div>
      </div>
    </section>

    <section class="mad-light mad-women mad-pad">
      <div class="mad-wide">
        <p class="mad-kicker dark">WOMEN MIXED OPEN</p>
        <h2>THEY DIDN’T<br/>COME TO WATCH.</h2>
        <p class="mad-lead short">The women’s field brought its own pace, pressure and aggression to the course. What began as another category quickly became one of the moments people remembered from the night.</p>
      </div>
      <figure class="mad-photo full"><img src={img('women-grid.webp')} srcset={srcset('women-grid', { xl: true })} sizes="min(1450px, 96vw)" width="1600" height="1066" alt="Women Mixed Open riders on the start line" loading="lazy" decoding="async" /></figure>
      <div class="mad-women-row">
        <figure class="mad-photo"><img src={img('women-podium.webp')} srcset={srcset('women-podium')} sizes="(min-width: 760px) 50vw, 100vw" width="1600" height="1066" alt="Women riders with their prizes on the Pedal &amp; Connect stage" loading="lazy" decoding="async" /></figure>
        <div class="mad-statement dark">FULL<br/>SEND.</div>
      </div>
    </section>

    <section class="mad-dark mad-results mad-pad" id="results">
      <div class="mad-wide">
        <p class="mad-kicker">OFFICIAL RESULTS / 26.09.26</p>
        <h2>WHO TOOK<br/>THE NIGHT.</h2>
        <div class="results-grid">
          {results.map((cat) => (
            <section class="result-card">
              <h3>{cat.label}</h3>
              {cat.rows.map((row) => (
                <div class="result-row"><b>{row[0]}</b><div><strong>{row[1]}</strong><span>{row[2]}</span></div></div>
              ))}
            </section>
          ))}
        </div>
        <a class="mad-link" href="https://race.maycbukitbintang.com/results" target="_blank" rel="noopener">VIEW FULL RACE RESULTS →</a>
      </div>
      <figure class="mad-photo medium"><img src={img('results.webp')} srcset={srcset('results')} sizes="min(1080px, 90vw)" width="1600" height="1066" alt="Metro Madness riders and organisers after the prize presentation" loading="lazy" decoding="async" /></figure>
    </section>

    <section class="mad-dark mad-ridewild mad-pad">
      <div class="mad-split ridewild-split">
        <figure class="mad-photo"><img src={img('syafiq.webp')} srcset={srcset('syafiq')} sizes="(min-width: 760px) 45vw, 100vw" width="1600" height="1066" alt="Syafiq Rahmat of RideWild KL addressing riders" loading="lazy" decoding="async" /></figure>
        <div class="mad-copyblock">
          <p class="mad-kicker">RIDEWILD KL / FIELD NOTES</p>
          <h2>PURE<br/>MADNESS.</h2>
          <blockquote>“METROMADNESS VOL.2 is definitely one of the maddest events we’ve experienced this year.”</blockquote>
          <blockquote>“Once the race started, it was nothing short of chaos and pure madness.”</blockquote>
          <blockquote>“What really stood out for us was the support from the community.”</blockquote>
          <p class="mad-by light">SYAFIQ RAHMAT<br/><span>RIDEWILD KL</span></p>
        </div>
      </div>
      <div class="mad-statement">RIDE WILD.<br/>AND BE SAFE. 🤙🏽</div>
    </section>

    <section class="mad-light mad-mayc mad-pad">
      <div class="mad-wide">
        <p class="mad-kicker dark">THE BIGGER POINT</p>
        <h2>THE PODIUM<br/>WAS NEVER<br/>THE WHOLE POINT.</h2>
      </div>
      <div class="mad-split reverse">
        <figure class="mad-photo"><img src={img('community.webp')} srcset={srcset('community')} sizes="(min-width: 760px) 45vw, 100vw" width="1600" height="1066" alt="The event team in matching Pedal &amp; Connect jerseys" loading="lazy" decoding="async" /></figure>
        <div class="mad-copyblock">
          <p>For MAYC Bukit Bintang, Pedal &amp; Connect is a platform to bring young people together through things they already care about.</p>
          <p>This time, Metro Madness was the activity. Pedal &amp; Connect was the platform.</p>
          <p>The activity may change. The purpose does not.</p>
          <p><strong>Create the space. Bring people together. Let the connection happen.</strong></p>
          <blockquote>“This success belongs to everyone who gave their time, energy and support. We hope this becomes the start of more youth programmes and more collaborations after this.”</blockquote>
          <p class="mad-by">HAIKAL ZAINI<br/><span>CHAIRMAN / MAYC BUKIT BINTANG</span></p>
        </div>
      </div>
      <div class="mad-haikal">
        <div class="mad-haikal-lead">
          <p class="mad-haikal-context">For MAYC Bukit Bintang Chairman Haikal Zaini, the significance of the night went beyond racing. The turnout reflected a wider need among young people for spaces built around their interests, communities and everyday realities.</p>
          <p class="mad-reach"><b>NEARLY</b><strong>3,000</strong><span>YOUTHS REACHED</span></p>
        </div>
        <div>
          <blockquote class="mad-haikal-quote" lang="ms">
            <p>“Pedal &amp; Connect Vol. 2 bukan sekadar program racing, tetapi satu bukti bahawa komuniti kita sebenarnya sangat dahagakan ruang untuk berkumpul, berinteraksi dan terlibat dalam aktiviti yang sihat.</p>
            <p>Ini merupakan program racing pertama yang kami anjurkan, namun sambutannya luar biasa apabila berjaya mencapai hampir 3,000 belia.</p>
            <p>Angka ini menunjukkan bahawa apabila kita hadir dengan program yang dekat dengan minat dan realiti kehidupan anak muda, mereka akan datang dan mereka akan terlibat.</p>
            <p>Bagi kami, impak sebenar program ini bukan hanya pada jumlah kehadiran, tetapi bagaimana kita berjaya membawa komuniti yang mungkin selama ini terpinggir kembali ke dalam satu ruang yang positif.</p>
            <p>Ini baru permulaan dan kami mahu terus membina lebih banyak platform yang benar-benar memberi impak kepada komuniti.”</p>
          </blockquote>
          <p class="mad-by">HAIKAL ZAINI<br/><span>CHAIRMAN / MAYC BUKIT BINTANG</span></p>
        </div>
      </div>
      <div class="mad-statement dark">COME FOR THE EVENT.<br/>LEAVE WITH A COMMUNITY.</div>
    </section>

    <section class="mad-light mad-bts mad-pad">
      <div class="mad-wide">
        <p class="mad-kicker dark">BEHIND THE NIGHT</p>
        <h2>YOU SAW THE RACE.<br/>YOU DIDN’T SEE<br/>EVERYTHING ELSE.</h2>
      </div>
      <div class="mad-split">
        <figure class="mad-photo"><img src={img('crew.webp')} srcset={srcset('crew')} sizes="(min-width: 760px) 45vw, 100vw" width="1600" height="1066" alt="Crew with mics and clipboards at the trackside" loading="lazy" decoding="async" /></figure>
        <div class="mad-copyblock">
          <p>Registration. Course prep. Rider calls. Timing. Volunteer coordination. Safety. Crowd movement. Awards. The small jobs that only become visible when one of them goes wrong.</p>
          <blockquote>“A lot happened behind the scenes that people didn’t see. The race only worked because a lot of people kept moving at the same time.”</blockquote>
          <p class="mad-by">ALIF RAMLAN<br/><span>PROGRAMME DIRECTOR / PEDAL &amp; CONNECT VOL.2</span></p>
        </div>
      </div>
    </section>

    <section class="mad-digital mad-pad">
      <div class="mad-wide">
        <p class="mad-kicker">BEHIND THE SCREEN</p>
        <h2>THE EVENT WAS<br/>MOVING ONLINE TOO.</h2>
        <p class="mad-digital-copy">“We wanted the digital side to make things easier, not make the event feel more complicated. Riders and spectators could follow the race, check heats and results, and stay updated from their phones. When traffic started increasing during the night, we expanded the capacity so the system could keep up with the crowd.”</p>
        <p class="mad-by light">ZAHID HELMI<br/><span>MULTIMEDIA BUREAU / PEDAL &amp; CONNECT VOL.2</span></p>
        <div class="metrics">
          <div><b>452</b><span>UNIQUE VISITORS</span></div>
          <div><b>819</b><span>VISITS</span></div>
          <div><b>3,431</b><span>PAGE VIEWS</span></div>
          <div><b>97%</b><span>MOBILE</span></div>
        </div>
        <p class="mad-data-note">Peak traffic hit <strong>613 page views between 22:00–23:00</strong>. As more people came online, the capacity had to grow with them.</p>
      </div>
    </section>

    <section class="mad-favourite mad-pad">
      <div class="mad-wide fav-grid">
        <div>
          <p class="mad-kicker dark">THE CROWD HAD A SAY</p>
          <div class="fav-number">048</div>
        </div>
        <div class="fav-copy">
          <h2>NORAIDILLINA<br/>ADILLA J. SAM</h2>
          <p>FAVOURITE RIDER / COMMUNITY VOTE</p>
          <strong>43 VOTES · 35.8%</strong>
          <span>120 total votes were cast across 23 riders.</span>
        </div>
      </div>
    </section>

    <section class="mad-dark mad-safety mad-pad">
      <div class="mad-narrow">
        <p class="mad-kicker">MEDICAL SUPPORT / FDI 01</p>
        <h2>RACING<br/>BITES BACK.</h2>
        <p>Five riders required medical attention during the event. Four were treated on site. One rider received initial treatment before being transferred to Hospital Selayang for further care.</p>
        <p class="mad-muted">To the medical crew who stayed ready throughout the night — thank you.</p>
      </div>
    </section>

    <section class="mad-light mad-photoessay mad-pad">
      <div class="mad-wide"><p class="mad-kicker dark">ONE LAST LOOK</p><h2>NO MORE REPORTING.<br/>JUST THE NIGHT.</h2></div>
      <div class="essay-grid">
        <figure class="essay-a"><img src={img('gallery-flag.webp')} srcset={srcset('gallery-flag', { xl: true })} sizes="(min-width: 760px) 64vw, 100vw" width="1600" height="1066" alt="The chequered flag in the air at the start line" loading="lazy" decoding="async" /></figure>
        <figure class="essay-b"><img src={img('gallery-grin.webp')} srcset={srcset('gallery-grin')} sizes="(min-width: 760px) 40vw, 100vw" width="1600" height="1066" alt="A rider grinning through a corner" loading="lazy" decoding="async" /></figure>
        <figure class="essay-c"><img src={img('gallery-rider.webp')} srcset={srcset('gallery-rider')} sizes="(min-width: 760px) 40vw, 100vw" width="1600" height="1066" alt="A rider on a fixed-gear bike under the lights" loading="lazy" decoding="async" /></figure>
