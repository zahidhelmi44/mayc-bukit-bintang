---
import Base from '../layouts/Base.astro';
---
<Base title="Halaman tidak dijumpai" barBawah={false}>
  <section class="seksyen">
    <div class="bekas" style="display:flex;flex-direction:column;gap:18px;align-items:flex-start;padding-bottom:40px">
      <h1 style="margin:0;font-size:clamp(44px,10vw,88px);letter-spacing:-0.04em;line-height:.95">Halaman ini <span class="serif">tiada.</span></h1>
      <p style="margin:0;max-width:44ch;color:var(--kelabu-2)">Pautan mungkin sudah bertukar atau salah taip. Cuba mula semula dari halaman utama.</p>
      <a class="btn btn-dakwat" href="/">Ke halaman utama</a>
    </div>
  </section>
</Base>
