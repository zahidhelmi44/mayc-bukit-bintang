---
import '../styles/global.css';
import '../styles/refresh.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarBawah from '../components/BarBawah.astro';
import tetapan from '../data/tetapan.json';
import acara from '../data/acara.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  halaman?: string;
  barBawah?: boolean;
}
const {
  title,
  description = 'MAYC Bukit Bintang — menyatukan belia sejak 1954 melalui sivik, sukan, rekreasi dan kesenian.',
  image = '/brand/og-default.jpg',
  type = 'website',
  halaman = '',
  barBawah = true,
} = Astro.props;
const tajuk = title ? `${title} | ${tetapan.namaCawangan}` : `${tetapan.namaCawangan} — Menyatukan belia sejak 1954`;
const kanonik = new URL(Astro.url.pathname, Astro.site);
const gambarOg = new URL(image, Astro.site);
---
<!doctype html>
<html lang="ms">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tajuk}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={kanonik} />
    <meta name="theme-color" content="#0B4EAA" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content={tetapan.namaCawangan} />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? tajuk} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={gambarOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <a class="lompat" href="#kandungan">Langkau ke kandungan</a>
    <Header halaman={halaman} />
    <main id="kandungan">
      <slot />
    </main>
    <Footer />
    {barBawah && <BarBawah />}
    {acara.aktif && <script type="application/json" id="data-acara" set:html={JSON.stringify(acara)} />}
    <script src="../scripts/acara.ts"></script>
  </body>
</html>
